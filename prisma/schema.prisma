generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Super_Admin
  Manager
  Accounts
  SR
}

enum OrderStatus {
  Draft
  Pending_Approval
  Approved
  Rejected
  Cancelled
  Delivered
}

enum InvoiceStatus {
  Draft
  Issued
  Paid
  Partial
  Overdue
}

enum PaymentMethod {
  Cash
  Bank
  Cheque
  Mobile_Banking
}

enum DeliveryMode {
  Truck
  Courier
  Pickup
  Company_Delivery
}

enum DeliveryChallanStatus {
  Draft
  Confirmed
  Cancelled
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated     SalesOrder[]      @relation("OrderCreatedBy")
  ordersApproved    SalesOrder[]      @relation("OrderApprovedBy")
  challansCreated   DeliveryChallan[] @relation("ChallanCreatedBy")
  challansConfirmed DeliveryChallan[] @relation("ChallanConfirmedBy")
  auditLogs         AuditLog[]
}

model Dealer {
  id String @id @default(uuid())

  dealerCode String @unique

  companyName    String
  proprietorName String?

  mobile String
  email  String?

  address String

  district  String
  territory String

  creditLimit    Decimal @db.Decimal(18, 2)
  currentBalance Decimal @default(0) @db.Decimal(18, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects         Project[]
  orders           SalesOrder[]
  deliveryChallans DeliveryChallan[]
  invoices         Invoice[]
  collections      Collection[]
  ledgerEntries    LedgerEntry[]
  dueReports       DueReport[]
}

model Project {
  id       String @id @default(cuid())
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  projectCode  String  @unique
  name         String
  address      String?
  contactName  String?
  contactPhone String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SalesOrder[]

  @@unique([dealerId, name])
  @@index([dealerId])
  @@index([name])
}

model Category {
  id String @id @default(uuid())

  name String
  slug String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id String @id @default(uuid())

  sku         String @unique
  modelNumber String @unique

  name   String
  nameBn String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  unit String @default("PCS")

  description String?

  currentPrice Decimal @db.Decimal(18, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems           SalesOrderItem[]
  deliveryChallanItems DeliveryChallanItem[]
}

model SalesOrder {
  id String @id @default(uuid())

  orderNo String @unique

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  status OrderStatus

  subtotal   Decimal @db.Decimal(18, 2)
  discount   Decimal @db.Decimal(18, 2)
  vat        Decimal @db.Decimal(18, 2)
  grandTotal Decimal @db.Decimal(18, 2)

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("OrderApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            SalesOrderItem[]
  invoices         Invoice[]
  deliveryChallans DeliveryChallan[]

  @@index([dealerCode])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
}

model SalesOrderItem {
  id String @id @default(uuid())

  orderId String

  order SalesOrder @relation(fields: [orderId], references: [id])

  productId String

  product Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(18, 2)

  unitPrice Decimal @db.Decimal(18, 2)

  discount Decimal @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  deliveryChallanItems DeliveryChallanItem[]

  @@index([orderId])
  @@index([productId])
}

model DeliveryChallan {
  id String @id @default(uuid())

  challanNo String @unique

  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id])

  dealerCode String
  dealer     Dealer @relation(fields: [dealerCode], references: [dealerCode])

  status DeliveryChallanStatus @default(Draft)

  deliveryMode DeliveryMode
  vehicleNo    String?
  driverName   String?
  remarks      String?

  dispatchedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ChallanCreatedBy", fields: [createdById], references: [id])

  confirmedById String?
  confirmedBy   User?   @relation("ChallanConfirmedBy", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   DeliveryChallanItem[]
  invoice Invoice?

  @@index([orderId])
  @@index([dealerCode])
  @@index([status])
  @@index([createdById])
  @@index([confirmedById])
  @@index([createdAt])
  @@index([dispatchedAt])
}

model DeliveryChallanItem {
  id String @id @default(uuid())

  challanId String
  challan   DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   SalesOrderItem @relation(fields: [orderItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(18, 2)

  @@index([challanId])
  @@index([orderItemId])
  @@index([productId])
}

model Invoice {
  id String @id @default(uuid())

  invoiceNo String @unique

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id])

  deliveryChallanId String?          @unique
  deliveryChallan   DeliveryChallan? @relation(fields: [deliveryChallanId], references: [id])

  status InvoiceStatus @default(Draft)

  subtotal Decimal @db.Decimal(18, 2)
  discount Decimal @db.Decimal(18, 2)
  vat      Decimal @db.Decimal(18, 2)

  previousDue        Decimal @db.Decimal(18, 2)
  collectionReceived Decimal @db.Decimal(18, 2)

  grandTotal Decimal @db.Decimal(18, 2)
  currentDue Decimal @db.Decimal(18, 2)

  deliveryMode DeliveryMode

  vehicleNo  String?
  driverName String?

  issueDate DateTime @default(now())
  dueDate   DateTime

  createdAt DateTime @default(now())

  collections Collection[]

  @@index([orderId])
  @@index([dealerCode])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model Collection {
  id String @id @default(uuid())

  receiptNo String @unique

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  amount Decimal @db.Decimal(18, 2)

  paymentMethod PaymentMethod

  referenceNo String?

  attachmentUrl String?

  createdAt DateTime @default(now())

  @@index([dealerCode])
  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([createdAt])
}

model LedgerEntry {
  id String @id @default(uuid())

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  transactionDate DateTime

  referenceType String
  referenceId   String

  debit   Decimal @db.Decimal(18, 2)
  credit  Decimal @db.Decimal(18, 2)
  balance Decimal @db.Decimal(18, 2)

  remarks String?

  createdAt DateTime @default(now())

  @@index([dealerCode])
  @@index([transactionDate])
  @@index([referenceType, referenceId])
}

model DueReport {
  id String @id @default(uuid())

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  totalDue Decimal @db.Decimal(18, 2)

  overdueAmount Decimal @db.Decimal(18, 2)

  overdueDays Int

  createdAt DateTime @default(now())

  @@index([dealerCode])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  entityType String

  entityId String

  action String

  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
