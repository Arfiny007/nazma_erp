generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Super_Admin
  Manager
  Accounts
  SR
}

/// Enterprise user lifecycle states. See PHASE_10A / ADR-049.
enum UserLifecycleStatus {
  INVITED
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
  ARCHIVED
}

enum OrderStatus {
  Draft
  Pending_Approval
  Approved
  Partially_Delivered
  Rejected
  Cancelled
  Delivered
}

enum InvoiceStatus {
  Draft
  Issued
  Paid
  Partial
  Overdue
}

enum PaymentMethod {
  Cash
  Bank
  Cheque
  Mobile_Banking
}

enum CollectionStatus {
  Draft
  Confirmed
  PartiallyAllocated
  Allocated
  Reversed
}

enum CollectionPaymentMethod {
  Cash
  Bank
  Cheque
  MobileBanking
  OnlineTransfer
  Other
}

enum FinancialReferenceType {
  Invoice
  Collection
  OpeningBalance
  CreditNote
  DebitNote
  ManualAdjustment
  JournalEntry
}

/// Discrete accounting event for a `LedgerEntry`.
///
/// `referenceType` identifies the source *document*; `postingType` identifies
/// the *event*. A single Invoice document may generate `Issue` and later
/// `Reversal` entries; a Collection generates `Collection` and, on reverse,
/// `Reversal`.
///
/// See ADR-024 §4 and ADR-025 for the append-only ledger contract.
enum LedgerPostingType {
  Issue
  Collection
  Reversal
  OpeningBalance
  CreditNote
  DebitNote
  ManualAdjustment
  JournalEntry
  Adjustment
}

/// Permanent lifecycle for a dealer's Opening Balance initialization record.
///
/// NotInitialized is not persisted — it is the absence of an `OpeningBalance`
/// row for a dealer. Draft is editable; Validated is ready for posting;
/// Posted means a `LedgerEntry` exists (or, for a zero amount, that no entry
/// was required); Locked is the permanent, immutable terminal state. Posting
/// and locking happen atomically in the same transaction — there is no
/// separate correction step between them. See ADR-028.
enum OpeningBalanceStatus {
  Draft
  Validated
  Posted
  Locked
}

/// Provenance of an Opening Balance record. `Manual` is the only producer
/// wired to a UI in PHASE_07C; the remaining values fix the contract for
/// future bulk import / ERP migration tooling that reuses the same service
/// without redesign (ADR-028 §7).
enum OpeningBalanceSource {
  Manual
  CsvImport
  ExcelImport
  ErpMigration
}

enum DeliveryMode {
  Truck
  Courier
  Pickup
  Company_Delivery
}

enum DeliveryChallanStatus {
  Draft
  Confirmed
  Cancelled
}

enum FinancialIntegrityScanStatus {
  Completed
  Failed
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole

  /// Legacy login gate — kept in sync with lifecycleStatus (ACTIVE => true).
  isActive Boolean @default(true)

  /// Enterprise lifecycle state machine. See PHASE_10A.
  lifecycleStatus UserLifecycleStatus @default(ACTIVE)

  /// When true, user must change password on next login (future phase).
  mustChangePassword Boolean @default(false)

  /// Direct manager for SR users (optional).
  managerId String?
  manager   User?  @relation("UserManagerHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[] @relation("UserManagerHierarchy")

  /// User who provisioned this account.
  provisionedById String?
  provisionedBy   User?  @relation("UserProvisionedBy", fields: [provisionedById], references: [id], onDelete: SetNull)
  usersProvisioned User[] @relation("UserProvisionedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated            SalesOrder[]      @relation("OrderCreatedBy")
  ordersApproved           SalesOrder[]      @relation("OrderApprovedBy")
  challansCreated          DeliveryChallan[] @relation("ChallanCreatedBy")
  challansConfirmed        DeliveryChallan[] @relation("ChallanConfirmedBy")
  collectionsCreated       Collection[]      @relation("CollectionCreatedBy")
  collectionsConfirmed     Collection[]      @relation("CollectionConfirmedBy")
  ledgerEntriesCreated     LedgerEntry[]     @relation("LedgerEntryCreatedBy")
  openingBalancesCreated   OpeningBalance[]  @relation("OpeningBalanceCreatedBy")
  openingBalancesValidated OpeningBalance[]  @relation("OpeningBalanceValidatedBy")
  openingBalancesPosted    OpeningBalance[]  @relation("OpeningBalancePostedBy")
  auditLogs                AuditLog[]
  territoryAssignments     UserTerritoryAssignment[]
  ownedDealers             DealerOwnershipHistory[] @relation("OwnershipAssignedSr")
  dealerOwnershipAssignedBy DealerOwnershipHistory[] @relation("OwnershipAssignedBy")
  profile                  UserProfile?
  invitationsReceived      UserInvitation[] @relation("InvitationTargetUser")
  invitationsSent          UserInvitation[] @relation("InvitationSentBy")
  activationTokens         UserActivationToken[]
}

/// Extended user profile — organizational metadata only. See PHASE_10A.
model UserProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone        String?
  employeeCode String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode])
}

/// Invitation record for enterprise user provisioning. See PHASE_10A.
model UserInvitation {
  id String @id @default(cuid())

  userId String
  user   User   @relation("InvitationTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitationSentBy", fields: [invitedById], references: [id])

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([invitedById])
}

/// Activation token storage (hashed). Reserved for PHASE_10B+ activation flows.
model UserActivationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Bangladesh administrative division (8 divisions). See PHASE_08A.
model Division {
  id String @id @default(uuid())

  /// Stable slug, e.g. `dhaka`.
  code String @unique

  name   String
  nameBn String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts District[]
  dealers   Dealer[]

  @@index([isActive, sortOrder])
}

/// Bangladesh district (64 districts). See PHASE_08A.
model District {
  id String @id @default(uuid())

  /// Stable slug scoped globally, e.g. `dhaka`.
  code String @unique

  name   String
  nameBn String

  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  territories Territory[]
  dealers     Dealer[]

  @@index([divisionId, isActive, sortOrder])
  @@index([name])
}

/// Company-defined sales territory within a district. See PHASE_08A.
model Territory {
  id String @id @default(uuid())

  /// Stable slug, e.g. `dhaka-central`.
  code String @unique

  name   String
  nameBn String?

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealers Dealer[]

  userAssignments UserTerritoryAssignment[]
  ownershipHistory DealerOwnershipHistory[]

  @@index([districtId, isActive, sortOrder])
  @@index([name])
}

model Dealer {
  id String @id @default(uuid())

  dealerCode String @unique

  companyName    String
  proprietorName String?

  mobile String
  email  String?

  address String

  /// Legacy free-text fields — retained for backward compatibility during migration.
  district  String
  territory String

  /// Structured geography FKs — optional until dealers are migrated. See PHASE_08A.
  divisionId  String?
  division    Division?  @relation(fields: [divisionId], references: [id])
  districtId  String?
  geoDistrict District?  @relation(fields: [districtId], references: [id])
  territoryId String?
  geoTerritory Territory? @relation(fields: [territoryId], references: [id])

  creditLimit    Decimal @db.Decimal(18, 2)
  /// Accounts Receivable balance — positive: dealer owes company; negative: company owes dealer (advance/credit). See ADR-019.
  currentBalance Decimal @default(0) @db.Decimal(18, 2)

  /// Sales targets for future dealer reporting — not computed in this phase.
  monthlyTarget Decimal @default(0) @db.Decimal(18, 2)
  yearlyTarget  Decimal @default(0) @db.Decimal(18, 2)
  /// Cumulative sales total for future reporting — not computed in this phase.
  totalSales    Decimal @default(0) @db.Decimal(18, 2)

  lastCollectionDate DateTime?
  lastInvoiceDate    DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects         Project[]
  orders           SalesOrder[]
  deliveryChallans DeliveryChallan[]
  invoices         Invoice[]
  collections      Collection[]
  ledgerEntries    LedgerEntry[]
  dueReports       DueReport[]
  /// At most one Opening Balance record per dealer, ever — enforced by the
  /// `@unique` constraint on `OpeningBalance.dealerCode`. See ADR-028.
  openingBalance   OpeningBalance?
  ownershipHistory DealerOwnershipHistory[]

  @@index([divisionId])
  @@index([districtId])
  @@index([territoryId])
}

/// Maps users (SR / Manager) to supervised sales territories. See PHASE_08B / ADR-038.
model UserTerritoryAssignment {
  id String @id @default(cuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id])
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, territoryId])
  @@index([userId])
  @@index([territoryId])
  @@index([userId, isActive])
}

/// Auditable dealer → territory ownership timeline. See PHASE_08C / ADR-039.
model DealerOwnershipHistory {
  id String @id @default(cuid())

  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])

  assignedSrId String?
  assignedSr   User? @relation("OwnershipAssignedSr", fields: [assignedSrId], references: [id])

  assignedById String
  assignedBy   User @relation("OwnershipAssignedBy", fields: [assignedById], references: [id])

  reason String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
  @@index([territoryId])
  @@index([assignedSrId])
  @@index([dealerId, isActive])
  @@index([isActive])
}

model Project {
  id       String @id @default(cuid())
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  projectCode  String  @unique
  name         String
  address      String?
  contactName  String?
  contactPhone String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SalesOrder[]

  @@unique([dealerId, name])
  @@index([dealerId])
  @@index([name])
}

model Category {
  id String @id @default(uuid())

  name String
  slug String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id String @id @default(uuid())

  sku         String @unique
  modelNumber String @unique

  name   String
  nameBn String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  unit String @default("PCS")

  description String?

  currentPrice Decimal @db.Decimal(18, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems           SalesOrderItem[]
  deliveryChallanItems DeliveryChallanItem[]
  invoiceItems         InvoiceItem[]
}

model SalesOrder {
  id String @id @default(uuid())

  orderNo String @unique

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  status OrderStatus

  subtotal   Decimal @db.Decimal(18, 2)
  discount   Decimal @db.Decimal(18, 2)
  vat        Decimal @db.Decimal(18, 2)
  grandTotal Decimal @db.Decimal(18, 2)

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("OrderApprovedBy", fields: [approvedById], references: [id])

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            SalesOrderItem[]
  invoices         Invoice[]
  deliveryChallans DeliveryChallan[]

  @@index([dealerCode])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
}

model SalesOrderItem {
  id String @id @default(uuid())

  orderId String

  order SalesOrder @relation(fields: [orderId], references: [id])

  productId String

  product Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(18, 2)

  unitPrice Decimal @db.Decimal(18, 2)

  discount Decimal @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  deliveryChallanItems DeliveryChallanItem[]

  @@index([orderId])
  @@index([productId])
}

model DeliveryChallan {
  id String @id @default(uuid())

  challanNo String @unique

  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id])

  dealerCode String
  dealer     Dealer @relation(fields: [dealerCode], references: [dealerCode])

  status DeliveryChallanStatus @default(Draft)

  deliveryMode DeliveryMode
  vehicleNo    String?
  driverName   String?
  remarks      String?

  dispatchedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ChallanCreatedBy", fields: [createdById], references: [id])

  confirmedById String?
  confirmedBy   User?   @relation("ChallanConfirmedBy", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   DeliveryChallanItem[]
  invoice Invoice?

  @@index([orderId])
  @@index([dealerCode])
  @@index([status])
  @@index([createdById])
  @@index([confirmedById])
  @@index([createdAt])
  @@index([dispatchedAt])
}

model DeliveryChallanItem {
  id String @id @default(uuid())

  challanId String
  challan   DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   SalesOrderItem @relation(fields: [orderItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(18, 2)

  invoiceItem InvoiceItem?

  @@index([challanId])
  @@index([orderItemId])
  @@index([productId])
}

model Invoice {
  id String @id @default(uuid())

  invoiceNo String @unique

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id])

  deliveryChallanId String?          @unique
  deliveryChallan   DeliveryChallan? @relation(fields: [deliveryChallanId], references: [id])

  status InvoiceStatus @default(Draft)

  subtotal Decimal @db.Decimal(18, 2)
  discount Decimal @db.Decimal(18, 2)
  vat      Decimal @db.Decimal(18, 2)

  previousDue        Decimal @db.Decimal(18, 2)
  collectionReceived Decimal @db.Decimal(18, 2)

  grandTotal Decimal @db.Decimal(18, 2)
  currentDue Decimal @db.Decimal(18, 2)

  deliveryMode DeliveryMode

  vehicleNo  String?
  driverName String?

  issueDate DateTime @default(now())
  dueDate   DateTime

  createdAt DateTime @default(now())

  items InvoiceItem[]

  @@index([orderId])
  @@index([dealerCode])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([deliveryChallanId])
}

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  challanItemId String?              @unique
  challanItem   DeliveryChallanItem? @relation(fields: [challanItemId], references: [id])

  orderItemId String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productCode String
  productName String
  unit        String

  quantity  Decimal @db.Decimal(18, 2)
  unitPrice Decimal @db.Decimal(18, 2)
  discount  Decimal @db.Decimal(18, 2)
  lineTotal Decimal @db.Decimal(18, 2)

  @@index([invoiceId])
  @@index([productId])
  @@index([orderItemId])
}

model Collection {
  id String @id @default(uuid())

  collectionNo String @unique

  dealerCode String
  dealer     Dealer @relation(fields: [dealerCode], references: [dealerCode])

  collectionDate DateTime

  paymentMethod CollectionPaymentMethod

  referenceNumber String?
  bankName        String?
  remarks         String?

  receivedAmount    Decimal @db.Decimal(18, 2)
  allocatedAmount   Decimal @default(0) @db.Decimal(18, 2)
  unallocatedAmount Decimal @db.Decimal(18, 2)

  status CollectionStatus @default(Draft)

  isAdvancePayment Boolean @default(false)

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("CollectionConfirmedBy", fields: [confirmedById], references: [id])

  reversedAt           DateTime?
  reversedCollectionId String?
  reversedCollection   Collection?  @relation("CollectionReversal", fields: [reversedCollectionId], references: [id])
  reversals            Collection[] @relation("CollectionReversal")
  reversalReason       String?

  createdById String?
  createdBy   User?   @relation("CollectionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations CollectionAllocation[]

  @@index([collectionNo])
  @@index([dealerCode])
  @@index([collectionDate])
  @@index([status])
  @@index([confirmedAt])
  @@index([createdById])
  @@index([confirmedById])
}

model CollectionAllocation {
  id String @id @default(uuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  referenceType FinancialReferenceType
  referenceId   String

  allocatedAmount Decimal @db.Decimal(18, 2)

  allocationOrder Int

  remarks String?

  createdAt DateTime @default(now())

  @@unique([collectionId, referenceType, referenceId])
  @@index([collectionId])
  @@index([referenceType])
  @@index([referenceId])
  @@index([referenceType, referenceId])
}

/// Append-only accounting subledger for dealer receivables.
///
/// - Rows are IMMUTABLE after insert. Corrections MUST create compensating
///   entries linked via `reversesEntryId`.
/// - Only `posting-service.ts` (via `src/lib/ledger/`) may insert rows.
/// - `postingKey` is the idempotency guard for retried postings.
/// - `LedgerEntry.balance` == `Dealer.currentBalance` after each commit.
///
/// See ADR-024 §4 and ADR-025.
model LedgerEntry {
  id String @id @default(uuid())

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  /// Business/value date used for statement ordering.
  transactionDate DateTime
  /// System timestamp when the entry was posted (append-only).
  postingDate     DateTime @default(now())

  referenceType FinancialReferenceType
  referenceId   String
  /// Human-readable reference (e.g., `INV-000123`, `COL-000045`).
  referenceNo   String

  postingType LedgerPostingType

  /// Idempotency key derived from `(referenceType, referenceId, postingType[, sequence])`.
  postingKey String @unique

  debit   Decimal @db.Decimal(18, 2)
  credit  Decimal @db.Decimal(18, 2)
  balance Decimal @db.Decimal(18, 2)

  /// Compensating reversal link. When set, this entry reverses `reverses`.
  reversesEntryId String?
  reverses        LedgerEntry?  @relation("LedgerReversal", fields: [reversesEntryId], references: [id])
  reversedBy      LedgerEntry[] @relation("LedgerReversal")

  createdById String?
  createdBy   User?   @relation("LedgerEntryCreatedBy", fields: [createdById], references: [id])

  remarks String?

  createdAt DateTime @default(now())

  @@index([dealerCode])
  @@index([transactionDate])
  @@index([postingDate])
  @@index([referenceType, referenceId])
  @@index([dealerCode, transactionDate])
  @@index([dealerCode, postingDate])
  @@index([reversesEntryId])
  @@index([createdById])
}

/// Financial Initialization Engine — one dealer's Opening Balance record.
///
/// Permanent lifecycle: Draft (editable) → Validated (ready) → Posted
/// (`LedgerEntry` created, or none required for a zero amount) → Locked
/// (immutable forever). A dealer may be initialized AT MOST ONCE — enforced
/// by the `@unique` constraint on `dealerCode`. Corrections after Locked
/// happen through Journal Entry / Manual Adjustment / Credit Note / Debit
/// Note — never by editing or deleting this row. See ADR-028.
model OpeningBalance {
  id String @id @default(uuid())

  dealerCode String @unique
  dealer     Dealer @relation(fields: [dealerCode], references: [dealerCode])

  /// Signed opening amount. Positive = dealer owes company; negative =
  /// advance credit; zero is a valid "no receivable at go-live" record.
  amount Decimal @db.Decimal(18, 2)

  /// Business/value date the opening balance takes effect.
  effectiveDate DateTime

  status OpeningBalanceStatus @default(Draft)

  /// Provenance — fixes the contract for future bulk import / migration
  /// tooling reusing this same engine. Only `Manual` is wired to a UI today.
  source OpeningBalanceSource @default(Manual)

  /// Canonical human-readable reference (`OB-<dealerCode>`).
  referenceNo String?

  remarks String?

  createdById String
  createdBy   User   @relation("OpeningBalanceCreatedBy", fields: [createdById], references: [id])

  validatedAt   DateTime?
  validatedById String?
  validatedBy   User?     @relation("OpeningBalanceValidatedBy", fields: [validatedById], references: [id])

  postedAt   DateTime?
  postedById String?
  postedBy   User?     @relation("OpeningBalancePostedBy", fields: [postedById], references: [id])

  /// Set together with `postedAt` — Posted and Locked are the same instant;
  /// there is no reviewable state between them (ADR-028 §4).
  lockedAt DateTime?

  /// Populated only when `amount != 0` — a zero opening balance never
  /// produces a `LedgerEntry` (there is nothing to post).
  ledgerEntryId String?
  postingKey    String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerCode])
  @@index([status])
  @@index([createdById])
}

model DueReport {
  id String @id @default(uuid())

  dealerCode String

  dealer Dealer @relation(fields: [dealerCode], references: [dealerCode])

  totalDue Decimal @db.Decimal(18, 2)

  overdueAmount Decimal @db.Decimal(18, 2)

  overdueDays Int

  createdAt DateTime @default(now())

  @@index([dealerCode])
  @@index([createdAt])
}

/// Scheduled Financial Integrity Monitor — PHASE_07E4.
/// Persists repository-wide reconciliation scan summaries only.
model FinancialIntegrityScan {
  id String @id @default(uuid())

  startedAt   DateTime
  completedAt DateTime?
  durationMs  Int?

  totalDealers         Int
  consistentDealers    Int
  driftedDealers       Int
  missingLedgerDealers Int
  corruptedDealers     Int

  status FinancialIntegrityScanStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startedAt])
  @@index([status])
}

model AuditLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  entityType String

  entityId String

  action String

  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
